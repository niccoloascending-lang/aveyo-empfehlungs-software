# Kopieren nach .env.local und ausfüllen. Niemals einchecken.

# Signiert Sitzungen und verschlüsselt gespeicherte Magic-Links. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Öffentliche Adresse der App (für Links, QR-Codes, Open-Graph-Bilder), ohne Schrägstrich am Ende.
GESCHENK_BASE_URL=http://localhost:3200

# 2FA für Berater-Login. Produktiv immer an. Nur lokal zum Durchklicken: aus
GESCHENK_2FA=an

# Cookies nur über HTTPS (produktiv: 1)
GESCHENK_HTTPS=0

# Datenordner (SQLite-Datenbank, Uploads, Entwicklungs-Postausgang)
# GESCHENK_DATA_DIR=./data

# E-Mail (EU-Anbieter, z. B. Brevo SMTP smtp-relay.brevo.com:587). Ohne SMTP_HOST landen Mails im
# Entwicklungs-Postausgang (data/postausgang) und sind im Admin unter „Postausgang“ sichtbar.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="AVEYO <hallo@aveyo.de>"
