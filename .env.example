# Kopieren nach .env.local und ausfüllen. Niemals einchecken.

# Signiert Sitzungen und verschlüsselt gespeicherte Magic-Links. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Öffentliche Adresse der App (für Links, QR-Codes, Open-Graph-Bilder), ohne Schrägstrich am Ende.
GESCHENK_BASE_URL=http://localhost:3200
# produktiv z. B. https://geschenk.aveyo.de

# 2FA für Berater-Login. Produktiv immer an. Nur lokal zum Durchklicken: aus
GESCHENK_2FA=an

# Cookies nur über HTTPS (produktiv: 1)
GESCHENK_HTTPS=0

# Datenordner (SQLite-Datenbank, Uploads, Entwicklungs-Postausgang)
# GESCHENK_DATA_DIR=./data

# E-Mail über Google Workspace. Ohne SMTP_HOST landen Mails im Entwicklungs-Postausgang (data/postausgang,
# im Admin unter „Postausgang“ sichtbar). Zwei Wege (README → E-Mail):
#  a) SMTP-Relay (empfohlen für den Server, feste IP im Workspace-Admin freigeben, kein Passwort nötig):
#     SMTP_HOST=smtp-relay.gmail.com  SMTP_PORT=587  (SMTP_USER/SMTP_PASS leer lassen)
#  b) Anmeldung mit App-Passwort eines Kontos, das als kontakt@aveyo.de senden darf:
#     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=…@aveyo.de  SMTP_PASS=<App-Passwort>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="AVEYO <kontakt@aveyo.de>"

# Google-Kalender (frei/belegt + bestätigte Termine eintragen): Pfad zum JSON-Schlüssel eines Google-Dienstkontos.
# Kalender-ID je Berater im Admin unter Einstellungen → Mein Profil. Ohne Schlüssel: nur die Wochen-Verfügbarkeit.
# GOOGLE_SERVICE_ACCOUNT_FILE=/etc/geschenk/google-dienstkonto.json
